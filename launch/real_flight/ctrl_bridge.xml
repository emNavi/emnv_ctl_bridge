<launch>
    <arg name = "drone_id" default="1"/>
    <arg name = "takeoff_height" default="0.3"/>
    <!-- RATE,ATTI,POSY  -->
    <arg name = "ctrl_pub_level" default = "POSY"/>
    <!-- RATE,ATTI,POSY  -->
    <arg name = "ctrl_mode" default = "POSY"/>
    <!-- mavros parameter -->
    <arg name="fcu_url"/>
    <arg name="gcs_udp_ip" default = ""/>
    <arg name="tgt_system" default = "1"/>

    <!-- vrpn parameter -->
    <arg name="vrpn_server_ip" default=""/>
    <arg name="vrpn_body_name" default="placeholder"/>

    <include file="$(find vrpn_client_ros)/launch/sample.launch">
        <arg name="server" value="$(arg vrpn_server_ip)"/>
    </include>

    <node name = "ctrl_bridge_$(arg drone_id)" pkg = "emnv_ctl_bridge" type = "ctrl_bridge" output = "screen" required="true">
        <remap from="~pos_sp_cmd" to="/drone_$(arg drone_id)_planning/lemniscate_point"/>    
        <remap from="~vrpn_pose" to="/vrpn_client_node/$(arg vrpn_body_name)/pose"/>
        <remap from="~vrpn_convert_pose" to="/mavros/vision_pose/pose"/>

        <remap from="~ref_odom" to="/mavros/local_position/odom"/> 
        <param name ="enable_vel_transpose_b2w" value="true"/>
        <!-- Warning: /mavros/local_position/odom 的vel 是机体坐标系的，需要坐标转换，请将enable_vel_transpose_b2w设置为true -->
        <param name ="drone_config_path" value="$(find emnv_ctl_bridge)/config/drone_X152b.yaml"/>

        <param name ="drone_id" value="$(arg drone_id)"/>
        <param name ="takeoff_height" value="$(arg takeoff_height)"/>
        <param name ="ctrl_pub_level" value="$(arg ctrl_pub_level)"/>
        <param name ="ctrl_mode" value="$(arg ctrl_mode)"/>
    </node> 

    <include file="$(find emnv_ctl_bridge)/launch/px4.launch">
        <arg name="fcu_url" value="$(arg fcu_url)"/>
        <arg name="gcs_url" value="udp://@$(arg gcs_udp_ip):14550"/>
        <arg name="tgt_system" value="$(arg tgt_system)"/>
    </include>

    
</launch>

